# Copy this file to .env.local and fill in your API keys

# === REQUIRED: Anthropic Claude API ===
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === REQUIRED: Supabase Database ===
# Get from: https://supabase.com/
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# === OPTIONAL: Apify Web Scraping ===
# Get from: https://apify.com/
# Used for: scraping LinkedIn, Reddit, Twitter posts
APIFY_TOKEN=your_apify_token_here

# === OPTIONAL: OpenRouter (Alternative AI Provider) ===
# Get from: https://openrouter.ai/
# Used for: idea generation, comment generation
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === OPTIONAL: vidIQ (YouTube/Instagram Mining) ===
# Get from: https://vidiq.com/
# Requires: Boost plan or higher
# Used for: mining YouTube/Instagram outliers for content ideas
VIDIQ_API_KEY=your_vidiq_api_key_here

# === OPTIONAL: Clay (Data Enrichment) ===
# Get from: https://clay.com/
# Used for: enriching company/person data
CLAY_API_KEY=your_clay_api_key_here

# === OPTIONAL: Your Other Tools ===
# Add any other API keys your workflows need
CUSTOM_API_KEY=your_custom_key_here
